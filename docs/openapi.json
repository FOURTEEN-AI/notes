{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "The REST API of the notes app, used by its own frontend.",
    "title" : "Notes API",
    "version" : "1"
  },
  "servers" : [ {
    "description" : "This app",
    "url" : "/"
  } ],
  "security" : [ {
    "basic" : [ ]
  } ],
  "tags" : [ {
    "name" : "preview"
  }, {
    "name" : "notes"
  }, {
    "name" : "ideas"
  } ],
  "paths" : {
    "/api/ideas" : {
      "get" : {
        "operationId" : "getApiIdeas",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Idea"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      },
      "post" : {
        "operationId" : "postApiIdeas",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewIdea"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Idea"
                }
              }
            },
            "description" : "Created"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      }
    },
    "/api/ideas/{number}/approval" : {
      "post" : {
        "operationId" : "postApiIdeasNumberApproval",
        "parameters" : [ {
          "in" : "path",
          "name" : "number",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      }
    },
    "/api/ideas/{number}/messages" : {
      "get" : {
        "operationId" : "getApiIdeasNumberMessages",
        "parameters" : [ {
          "in" : "path",
          "name" : "number",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ChatMessage"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      },
      "post" : {
        "operationId" : "postApiIdeasNumberMessages",
        "parameters" : [ {
          "in" : "path",
          "name" : "number",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewMessage"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChatMessage"
                }
              }
            },
            "description" : "Created"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      }
    },
    "/api/ideas/{number}/previous-scenarios" : {
      "get" : {
        "operationId" : "getApiIdeasNumberPreviousScenarios",
        "parameters" : [ {
          "in" : "path",
          "name" : "number",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Scenario"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "ideas" ]
      }
    },
    "/api/notes" : {
      "get" : {
        "operationId" : "getApiNotes",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/Note"
                  }
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "notes" ]
      },
      "post" : {
        "operationId" : "postApiNotes",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewNote"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Note"
                }
              }
            },
            "description" : "Created"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "notes" ]
      }
    },
    "/api/notes/{id}" : {
      "delete" : {
        "operationId" : "deleteApiNotesId",
        "parameters" : [ {
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "notes" ]
      }
    },
    "/api/preview" : {
      "get" : {
        "operationId" : "getApiPreview",
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PreviewResponse"
                }
              }
            },
            "description" : "OK"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
        "tags" : [ "preview" ]
      }
    },
    "/api/preview/feedback" : {
      "post" : {
        "operationId" : "postApiPreviewFeedback",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/Feedback"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "description" : "Created"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
