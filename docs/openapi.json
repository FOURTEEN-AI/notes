    "/api/preview/merge" : {
      "post" : {
        "operationId" : "postApiPreviewMerge",
        "responses" : {
          "204" : {
            "description" : "No Content"
          },
          "401" : {
            "description" : "No or wrong login"
          },
          "default" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Failure"
          }
        },
