      }
    }
  },
  "components" : {
    "schemas" : {
      "ChatMessage" : {
        "type" : "object",
        "properties" : {
          "author" : {
            "type" : "string"
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "author", "text" ]
      },
      "DemoStepResponse" : {
        "type" : "object",
        "properties" : {
          "do" : {
            "type" : "string"
          },
          "expect" : {
            "type" : "string"
          },
          "selector" : {
            "type" : [ "string", "null" ]
          }
        },
        "required" : [ "do", "expect" ]
      },
      "Feedback" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "text" ]
      },
      "Idea" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "number" : {
            "type" : "integer",
            "format" : "int32"
          },
          "previewReady" : {
            "type" : "boolean"
          },
          "previewUrl" : {
            "type" : [ "string", "null" ]
          },
          "status" : {
            "type" : "string",
            "enum" : [ "REFINING", "WAITING_FOR_ANSWER", "AGENT_WORKING", "REVIEW_RUNNING", "READY_FOR_DEMO", "WAITING_FOR_HUMAN" ]
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "description", "number", "previewReady", "status", "title" ]
      },
      "NewIdea" : {
        "type" : "object",
        "properties" : {
          "description" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "description", "title" ]
      },
      "NewMessage" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "text" ]
      },
      "NewNote" : {
        "type" : "object",
        "properties" : {
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "text" ]
      },
      "Note" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "text" : {
            "type" : "string"
          }
        },
        "required" : [ "createdAt", "id", "text" ]
      },
      "PreviewResponse" : {
        "type" : "object",
        "properties" : {
          "acceptance" : {
            "type" : "string",
            "enum" : [ "PENDING", "SUCCESS", "FAILURE" ]
          },
          "build" : {
            "type" : "string",
            "enum" : [ "PENDING", "SUCCESS", "FAILURE" ]
          },
          "demo" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/DemoStepResponse"
            }
          },
          "deployedSha" : {
            "type" : "string"
          },
          "issue" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          },
          "mergeable" : {
            "type" : "boolean"
          },
          "number" : {
            "type" : "integer",
            "format" : "int32"
          },
          "proposal" : {
            "type" : [ "string", "null" ]
          },
          "review" : {
            "type" : "string",
            "enum" : [ "PENDING", "SUCCESS", "FAILURE" ]
          },
          "state" : {
            "type" : "string"
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "acceptance", "build", "demo", "deployedSha", "mergeable", "number", "review", "state", "title" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "Scenario" : {
        "type" : "object",
        "properties" : {
          "steps" : {
            "type" : "array",
            "items" : {
              "type" : "string"
            }
          },
          "title" : {
            "type" : "string"
          }
        },
        "required" : [ "steps", "title" ]
      }
    },
    "securitySchemes" : {
      "basic" : {
        "scheme" : "basic",
        "type" : "http"
      }
    }
  }
}
