#!/usr/bin/env bash
# Blocks a commit that adds a secret (gitleaks, rules in .gitleaks.toml) and a commit on main in
# the main checkout while another worktree exists (parallel sessions work in their own worktree,
# see CLAUDE.md). Set up by .devcontainer/post-create.sh with `git config core.hooksPath .githooks`.
if [ "$(git rev-parse --git-dir)" = "$(git rev-parse --git-common-dir)" ] \
  && [ "$(git branch --show-current)" = "main" ] \
  && [ "$(git worktree list --porcelain | grep -c '^worktree ')" -gt 1 ]; then
  echo "pre-commit: another worktree exists, so no commits on main in the main checkout." >&2
  echo "Work in your own worktree (claude -w <name>), then: git fetch && git rebase origin/main && git push origin HEAD:main" >&2
  exit 1
fi
if ! command -v gitleaks > /dev/null; then
  echo "pre-commit: gitleaks is not installed, skipping (run .devcontainer/install-gitleaks.sh); CI scans anyway." >&2
  exit 0
fi
exec gitleaks git --pre-commit --staged --redact --no-banner --verbose
